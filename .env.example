# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=whisperdocs
POSTGRES_PASSWORD=whisperdocs
POSTGRES_DB=whisperdocs
# The database's port on the host (docker compose); 5435 when unset.
# DB_PORT=5435

# asyncpg URL (used by SQLAlchemy + checkpointer startup)
DATABASE_URL=postgresql+asyncpg://whisperdocs:whisperdocs@db:5432/whisperdocs

# ── LLM Providers ─────────────────────────────────────────────────────────────
# At least one provider must be configured.

# OpenAI — used for embeddings (required)
OPENAI_API_KEY=

# Google Gemini via Vertex AI (optional)
# Auth via Application Default Credentials: `gcloud auth application-default login`
# (or a service account key via GOOGLE_APPLICATION_CREDENTIALS).
GCP_PROJECT=
# gemini-3.8-flash is served from `global`, `us` or `eu` only; a regional
# location such as us-central1 fails.
GCP_LOCATION=global
# Thinking depth for Gemini 3+ models: low | medium | high (default: low).
# GEMINI_THINKING_LEVEL=low

# AWS Bedrock (optional — recommended for Claude models)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Effort for Claude 4.7+ on Bedrock: low | medium | high | xhigh | max
# (default: low). Empty = the model's default (high on Claude Sonnet 5.5).
# BEDROCK_CLAUDE_EFFORT=low

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── Agent — per-node model selection ─────────────────────────────────────────
# Model IDs: Gemini model names (`gemini-...`) or Bedrock Claude IDs
# (`us.anthropic.claude-...` or `anthropic.claude-...`). The provider is picked
# from the ID; Anthropic API IDs such as `claude-sonnet-4-6` are not routed.
# Claude Sonnet 5.5, Sonnet 4.5's replacement, is
# `global.anthropic.claude-sonnet-5-5`. The app refuses to start on an ID it
# can't route.
# Defaults shown below — override only what you need.

# AGENT_MODEL_CLASSIFIER=gemini-3.8-flash
# AGENT_MODEL_QUERY_REWRITE=gemini-3.8-flash
# AGENT_MODEL_RAG_GENERATION=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AGENT_MODEL_CLARIFICATION=gemini-3.8-flash
# AGENT_MODEL_ANSWER_DIRECT=gemini-3.8-flash
# AGENT_MODEL_SUMMARIZE=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AGENT_MODEL_EVAL_JUDGE=gemini-3.8-flash

# Per-node temperature (AGENT_TEMP_<ALIAS>). Sent only to models that accept
# it: Gemini 3+ and Claude 4.7+ use fixed sampling and ignore these.
# AGENT_TEMP_RAG_GENERATION=0.3

# Eval: abort the run when more than this share of judge calls fail.
# AGENT_EVAL_MAX_JUDGE_ERROR_RATE=0.1
# Eval: the CLI exits 3 below this accuracy or above this hallucination rate
# (0 and 1 turn them off).
# AGENT_EVAL_MIN_ACCURACY=0.80
# AGENT_EVAL_MAX_HALLUCINATION_RATE=0.10
# Eval: `runner diff` exits 3 when accuracy drops, or the hallucination rate
# rises, more than this over the previous run (1 turns it off).
# AGENT_EVAL_MAX_ACCURACY_DROP=0.10
# AGENT_EVAL_MAX_HALLUCINATION_RISE=0.10
# Eval: the RAG model's temperature in a run, in place of the chat's (sent
# only to models that accept it).
# AGENT_EVAL_RAG_TEMPERATURE=0.0
# Eval: the judge's verdicts, reused for the same answer to the same question
# (empty turns the cache off; `runner run --no-judge-cache` skips it once).
# AGENT_EVAL_JUDGE_CACHE=eval/cache/judge.jsonl

# ── Agent — memory / compaction ───────────────────────────────────────────────
# AGENT_COMPACTION_TOKEN_THRESHOLD=8000
# AGENT_COMPACTION_COUNT_THRESHOLD=30
# After a failed summary, messages to wait before compacting again.
# AGENT_COMPACTION_RETRY_MESSAGES=6
# Seconds between sweeps that keep each thread's latest checkpoint and delete
# the older ones (0 turns pruning off).
# AGENT_CHECKPOINT_PRUNE_INTERVAL_S=600
# AGENT_K_RECENT=8
# AGENT_RETRIEVAL_TOP_K=5
# AGENT_STREAMING_TOKENS=true   # token-level SSE for /agent/chat/stream

# ── Retrieval refinement ─────────────────────────────────────────────────────
# Cross-encoder reranking (requires `pip install -e .[rerank]` for sentence-transformers).
# Off by default — enable when measuring quality lift via the eval suite.
# RERANKER_ENABLED=false
# RERANKER_MODEL=BAAI/bge-reranker-base
# Candidates fetched for the reranker / MMR. Each hybrid leg returns at least 20 rows.
# RERANKER_CANDIDATE_POOL=20

# Doc-level Maximal Marginal Relevance — penalizes chunks from already-selected docs.
# MMR_ENABLED=false
# MMR_LAMBDA=0.5

# ── Twilio / WhatsApp ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox default

# Must match exactly the URLs configured in Twilio Console.
# For local dev: use ngrok — e.g. https://xxxx.ngrok-free.app/api/v1/webhook/whatsapp
TWILIO_WEBHOOK_URL=
TWILIO_STATUS_WEBHOOK_URL=

# ── Agent behavior ────────────────────────────────────────────────────────────
# Collection used for new WhatsApp threads. Unset = search all collections
# (an empty value fails to parse as an integer).
# DEFAULT_COLLECTION_ID=1

# Days before an unsaved conversation is eligible for deletion (0 = never expire)
# CONVERSATION_GRACE_PERIOD_DAYS=7

# ── Tracing (OpenTelemetry) ──────────────────────────────────────────────────
# OTLP/HTTP base URL; /v1/traces is appended. Unset = spans stay in the process
# (they still give the logs and query_logs a trace_id). For the compose
# Langfuse (`docker compose --profile tracing up -d`):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20cGstbGYtd2hpc3BlcmRvY3MtbG9jYWw6c2stbGYtd2hpc3BlcmRvY3MtbG9jYWw=,x-langfuse-ingestion-version=4
# Where the History page links a turn's trace, {trace_id} for the id. A build
# argument of the compose frontend (`docker compose build frontend`); for
# `npm run dev`, put it in frontend/.env. Unset = the id without a link.
# VITE_TRACE_URL=http://localhost:3000/project/whisperdocs/traces/{trace_id}

# ── API ───────────────────────────────────────────────────────────────────────
# Browser origins allowed by CORS (JSON array). Default: the compose frontend
# (localhost:8080) and the Vite dev server (localhost:5173).
# CORS_ALLOWED_ORIGINS=["http://localhost:8080", "http://localhost:5173"]

# The key every route needs, sent as X-API-Key. Unset or empty = open API, as
# the local demo is: set it before the API can be reached from another machine.
# GET /health (without ?deep=true) and the WhatsApp webhook never need it.
# API_KEY=

# Requests a minute per client (its key with API_KEY set, its IP otherwise);
# 0 turns a limit off. Past one: 429 with Retry-After.
# RATE_LIMIT_PER_MINUTE=30          # /query, /retrieve, /agent/chat*, /health?deep=true,
#                                   # and each WhatsApp number's messages
# RATE_LIMIT_UPLOAD_PER_MINUTE=60   # one request per file
# RATE_LIMIT_EVAL_PER_MINUTE=2      # /eval/run
